APP_NAME=OAPTEKA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://oapteka.test
# Available only in local and testing environments. Leave empty to require SMS OTP.
DEVELOPMENT_OTP_CODE=000000
AUTH_ADMIN_2FA_ENABLED=false
DB_DATABASE=oapteka
DB_USERNAME=oapteka
DB_PASSWORD=change-me
TRAEFIK_HOST=oapteka.test

# Enable after migrations and a successful account-role backfill on every node.
ACCOUNT_MODES_ENABLED=false
SESSION_BLOCK_STORE=database
SESSION_BLOCK_LOCK_SECONDS=300
SESSION_BLOCK_WAIT_SECONDS=10

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

CONTACT_EMAIL=
CONTACT_PHONE=
CONTACT_WHATSAPP_PHONE=
