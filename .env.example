APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

OSON_SMS_LOGIN=
OSON_SMS_TOKEN=
OSON_SMS_SENDER=
OSON_SMS_SERVER=https://api.osonsms.com/sendsms_v1.php
OSON_SMS_DRIVER=oson
OSON_SMS_DUMMY_CODE=

# Available only in local and testing environments. Leave empty to require SMS OTP.
DEVELOPMENT_OTP_CODE=000000
AUTH_PROVIDER_ACCESS_SUSPENDED=true
AUTH_ADMIN_2FA_ENABLED=false

ORDERS_PLACEMENT_ENABLED=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Enable after migrations and a successful account-role backfill on every node.
ACCOUNT_MODES_ENABLED=false
SESSION_BLOCK_STORE=database
SESSION_BLOCK_LOCK_SECONDS=300
SESSION_BLOCK_WAIT_SECONDS=10

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

GMAIL_IMPORTS_ENABLED=false
GMAIL_IMPORTS_CONNECTION_ID=
GMAIL_IMPORTS_MAILBOX=
GMAIL_IMPORTS_QUEUE=gmail-imports

CONTACT_EMAIL=
CONTACT_PHONE=
CONTACT_WHATSAPP_PHONE=
SESSION_EXPIRE_ON_CLOSE=false
