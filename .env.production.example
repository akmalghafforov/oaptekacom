# Copy to .env.production and chmod 600; never commit this file with secrets.
# REQUIRED: APP_KEY (persistent), DB_PASSWORD (strong), OSON_SMS_LOGIN,
# OSON_SMS_TOKEN, OSON_SMS_SENDER, APP_SOURCE_PATH, RELEASE_TAG, and APP_URL.
# APP_URL must use HTTPS and match TRAEFIK_HOST. Keep APP_KEY across releases.
# Database queue reservation is fixed at 150 seconds by Compose (worker timeout 120).
APP_NAME=OAPTEKA
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://oapteka.app
TRAEFIK_HOST=oapteka.app
# Required: immutable runtime image tag; change only when rebuilding images.
# Keep unchanged for make apply updates; deployed source follows the checked-out Git revision.
RELEASE_TAG=
# Required: absolute path to this separate OApteka checkout on the server.
APP_SOURCE_PATH=
# Verify these subnets and the Nginx address are unused on the actual server.
APPLICATION_SUBNET=172.30.85.0/24
DATABASE_SUBNET=172.30.84.0/24
NGINX_PRIVATE_ADDRESS=172.30.85.10
# Existing shared Traefik settings; verify without modifying shared resources.
TRAEFIK_NETWORK=traefik-net
TRAEFIK_CERT_RESOLVER=cloudflare
TRAEFIK_HTTP_MIDDLEWARE=https-redirect@file
TRAEFIK_HTTPS_MIDDLEWARE=secureHeaders@file
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=oapteka
DB_USERNAME=oapteka
DB_PASSWORD=
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null
SESSION_COOKIE=oapteka_op_session
QUEUE_CONNECTION=database
PRICE_LIST_QUEUE=price-list-imports
DB_QUEUE_RETRY_AFTER=150
FILESYSTEM_DISK=local
PRICE_LIST_DISK=local
ORDERS_PLACEMENT_ENABLED=false
LOG_CHANNEL=stderr
LOG_LEVEL=info
OSON_SMS_LOGIN=
OSON_SMS_TOKEN=
OSON_SMS_SENDER=
OSON_SMS_DRIVER=oson
OSON_SMS_DUMMY_CODE=
DEVELOPMENT_OTP_CODE=
AUTH_ADMIN_2FA_ENABLED=true
# TRUSTED_PROXIES is derived from NGINX_PRIVATE_ADDRESS by Compose.

# Enable after migrations and a successful account-role backfill on every node.
ACCOUNT_MODES_ENABLED=false
SESSION_BLOCK_STORE=database
SESSION_BLOCK_LOCK_SECONDS=300
SESSION_BLOCK_WAIT_SECONDS=10

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Enable after connecting the designated Gmail account and running migrations.
GMAIL_IMPORTS_ENABLED=false
GMAIL_IMPORTS_CONNECTION_ID=
GMAIL_IMPORTS_MAILBOX=
GMAIL_IMPORTS_QUEUE=gmail-imports

CONTACT_EMAIL=
CONTACT_PHONE=
CONTACT_WHATSAPP_PHONE=
