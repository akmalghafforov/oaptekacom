# Copy to .env.production, fill secrets, then use --env-file .env.production.
# Check that 172.30.84.0/24 and 172.30.85.0/24 are unused on the server.
# Keep APP_KEY and RELEASE_TAG stable for the lifetime of a release.
APP_NAME=OAPTEKA
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://op.fannjourney.com
TRAEFIK_HOST=op.fannjourney.com
RELEASE_TAG=
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=oapteka
DB_USERNAME=oapteka
DB_PASSWORD=
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null
SESSION_COOKIE=oapteka_op_session
QUEUE_CONNECTION=database
PRICE_LIST_QUEUE=price-list-imports
DB_QUEUE_RETRY_AFTER=150
FILESYSTEM_DISK=local
PRICE_LIST_DISK=local
ORDERS_PLACEMENT_ENABLED=false
LOG_CHANNEL=stderr
LOG_LEVEL=info
OSON_SMS_LOGIN=
OSON_SMS_TOKEN=
OSON_SMS_SENDER=
DEVELOPMENT_OTP_CODE=
TRUSTED_PROXIES=172.30.85.10
